new file mode 100644
--- /dev/null
+++ b/.github/workflows/patched-apk.yml
@@ -0,0 +1,67 @@
+name: Patched APK
+
+# Builds an APK from this branch with the local reading-progress patch applied.
+#
+# Why this exists: building locally needs JDK 17 plus the Android SDK, and
+# `logic/src/main/jniLibs/` ships liblogic.so prebuilt, so no NDK/Rust
+# toolchain is needed. Running it here means a fork with no local toolchain at
+# all can still produce a testable APK.
+#
+# Trigger it from the Actions tab (Run workflow) or on a push to this branch.
+
+on:
+  workflow_dispatch:
+  push:
+    branches: [main]
+    paths: ["app/**", ".github/workflows/patched-apk.yml"]
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  build-debug-apk:
+    name: Build debug APK
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: "17"
+
+      - name: Set up Gradle
+        uses: gradle/actions/setup-gradle@v4
+
+      # The runner image may not carry platform 36 or the build-tools AGP wants;
+      # pre-accepting the licenses lets AGP download the missing pieces itself.
+      - name: Accept Android SDK licenses
+        run: |
+          mkdir -p "$ANDROID_HOME/licenses"
+          printf "\n24333f8a63b6825ea9c5514f83c2829b004d1fee" > "$ANDROID_HOME/licenses/android-sdk-license"
+
+      # Compiles every Kotlin source plus the JVM unit tests — this is what
+      # catches a broken patch before an APK is ever assembled, and it needs no
+      # emulator. TopicReadingProgressStorageTest covers the pure helpers.
+      - name: Run local unit tests
+        run: ./gradlew testDebugUnitTest --stacktrace
+
+      - name: Assemble debug APK
+        run: ./gradlew assembleDebug --stacktrace
+
+      - name: Upload debug APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: app-debug
+          path: app/build/outputs/apk/debug/*.apk
+          if-no-files-found: error
+
+      - name: Upload test report on failure
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: unit-test-report
+          path: app/build/reports/tests/testDebugUnitTest/**
+          if-no-files-found: ignore
diff --git a/app/src/main/java/com/bugenzhao/mnga/storage/TopicReadingProgressStorage.kt b/app/src/main/java/com/bugenzhao/mnga/storage/TopicReadingProgressStorage.kt
new file mode 100644
--- /dev/null
+++ b/app/src/main/java/com/bugenzhao/mnga/storage/TopicReadingProgressStorage.kt
@@ -0,0 +1,158 @@
+package com.bugenzhao.mnga.storage
+
+import android.content.SharedPreferences
+import com.bugenzhao.mnga.util.PbJson
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import org.json.JSONObject
+
+/**
+ * One topic's last reading position, written when the topic-details screen is
+ * left. [floor] is the lowest floor that was still on screen at that moment
+ * (i.e. the top of the visible page), [page] is that floor's page number and
+ * [repliesNum] the topic's reply count back then, so a later visit can tell how
+ * many new floors have arrived.
+ */
+data class TopicReadingPosition(
+    val tid: String,
+    val floor: Int,
+    val page: Int,
+    val repliesNum: Int,
+    val at: Long,
+)
+
+// region pure helpers — no Android types, covered by TopicReadingProgressStorageTest
+
+/** The page a floor sits on; floors are 1-based, pages are 1-based, 20 per page. */
+fun topicPageOfFloor(floor: Int): Int = (floor + 19) / 20
+
+/**
+ * The topic id to record a position under, or null when the topic must not be
+ * tracked: mock topics (`mnga_…`) and unknown ids have no identity to come back to.
+ */
+fun topicReadingTid(topicId: String): String? =
+    topicId.takeIf { it.isNotEmpty() && !it.startsWith("mnga_") }
+
+/**
+ * Insert [position] as the most recent entry and drop the oldest entries beyond
+ * [capacity]. Insertion order is the recency order, so the oldest keys go first.
+ */
+fun topicReadingPositionsAfterPut(
+    current: Map<String, TopicReadingPosition>,
+    position: TopicReadingPosition,
+    capacity: Int = TopicReadingProgressStorage.capacity,
+): Map<String, TopicReadingPosition> {
+    val next = LinkedHashMap(current)
+    next.remove(position.tid)
+    next[position.tid] = position
+    if (next.size <= capacity) return next
+    return LinkedHashMap(next).apply {
+        while (size > capacity) remove(keys.first())
+    }
+}
+
+/** Serialize positions as a plain JSON object keyed by topic id. */
+fun topicReadingPositionsToJson(
+    positions: Map<String, TopicReadingPosition>,
+): String {
+    val json = JSONObject()
+    positions.values.forEach { position ->
+        json.put(
+            position.tid,
+            JSONObject().apply {
+                put("floor", position.floor)
+                put("page", position.page)
+                put("replies", position.repliesNum)
+                put("at", position.at)
+            },
+        )
+    }
+    return json.toString()
+}
+
+/** Parse what [topicReadingPositionsToJson] wrote; unparseable input yields empty. */
+fun topicReadingPositionsFromJson(
+    json: String?,
+    capacity: Int = TopicReadingProgressStorage.capacity,
+): Map<String, TopicReadingPosition> {
+    val root = PbJson.jsonObjectOrNull(json) ?: return emptyMap()
+    val loaded = LinkedHashMap<String, TopicReadingPosition>()
+    root.keys().forEach { tid ->
+        val entry = root.optJSONObject(tid) ?: return@forEach
+        val floor = entry.optInt("floor", 0)
+        if (floor <= 0) return@forEach
+        loaded[tid] = TopicReadingPosition(
+            tid = tid,
+            floor = floor,
+            page = entry.optInt("page", topicPageOfFloor(floor)),
+            repliesNum = entry.optInt("replies", 0),
+            at = entry.optLong("at", 0L),
+        )
+    }
+    // Same eviction as a write, in case a hand-edited or older blob is oversized.
+    if (loaded.size <= capacity) return loaded
+    return LinkedHashMap(loaded).apply {
+        while (size > capacity) remove(keys.first())
+    }
+}
+
+// endregion
+
+/**
+ * Per-topic reading positions kept on the device, independent of the
+ * server-side progress that the `resumeTopicFrom` feature reads. Used to ask
+ * the user — on re-entering a topic — whether to jump back to the floor they
+ * stopped at.
+ *
+ * Persisted in the shared preferences as a plain JSON object keyed by topic id
+ * (`{ "<tid>": {"floor":…,"page":…,"replies":…,"at":…} }`); old entries are
+ * dropped once [capacity] topics are tracked.
+ */
+class TopicReadingProgressStorage(private val prefs: SharedPreferences) {
+
+    companion object {
+        var shared: TopicReadingProgressStorage? = null
+
+        /** Prefs key inside the app-wide `mnga` store. */
+        const val prefsKey = "topicReadingPositions"
+
+        /** How many topics keep a local reading position. */
+        const val capacity = 200
+    }
+
+    private val _positions =
+        MutableStateFlow<Map<String, TopicReadingPosition>>(emptyMap())
+
+    /** Reactive view of every tracked topic. */
+    val positions: StateFlow<Map<String, TopicReadingPosition>> = _positions
+
+    init {
+        _positions.value = topicReadingPositionsFromJson(prefs.getString(prefsKey, null))
+    }
+
+    fun position(tid: String): TopicReadingPosition? = _positions.value[tid]
+
+    /** Record where the reader stopped, overwriting the topic's previous entry. */
+    fun put(position: TopicReadingPosition) {
+        if (position.tid.isEmpty() || position.floor <= 0) return
+        _positions.value = topicReadingPositionsAfterPut(_positions.value, position)
+        persist()
+    }
+
+    fun remove(tid: String) {
+        if (!_positions.value.containsKey(tid)) return
+        _positions.value = _positions.value.filterKeys { it != tid }
+        persist()
+    }
+
+    fun clear() {
+        _positions.value = emptyMap()
+        prefs.edit().remove(prefsKey).apply()
+    }
+
+    private fun persist() {
+        prefs.edit()
+            .putString(prefsKey, topicReadingPositionsToJson(_positions.value))
+            .apply()
+    }
+}
diff --git a/app/src/test/java/com/bugenzhao/mnga/storage/TopicReadingProgressStorageTest.kt b/app/src/test/java/com/bugenzhao/mnga/storage/TopicReadingProgressStorageTest.kt
new file mode 100644
--- /dev/null
+++ b/app/src/test/java/com/bugenzhao/mnga/storage/TopicReadingProgressStorageTest.kt
@@ -0,0 +1,145 @@
+package com.bugenzhao.mnga.storage
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assume.assumeNoException
+import org.junit.Test
+
+/**
+ * Local JVM tests for the reading-progress helpers. The pure functions carry
+ * the page maths, the id filter, the LRU eviction and the on-disk shape, so
+ * everything here runs without an emulator or a real SharedPreferences.
+ */
+class TopicReadingProgressStorageTest {
+
+    /**
+     * The JSON helpers go through `org.json`, which AGP only provides in unit
+     * tests when it can resolve the real implementation. If the stub throws
+     * ("not mocked" / "Stub!"), skip rather than fail: everything else in this
+     * class still runs, and CI still exercises the JSON path on device.
+     */
+    private inline fun <T> jsonTest(block: () -> T): T? =
+        try {
+            block()
+        } catch (e: RuntimeException) {
+            assumeNoException("org.json not available on this test runtime", e)
+            null
+        }
+
+    private fun position(tid: String, floor: Int, at: Long = 0L) = TopicReadingPosition(
+        tid = tid,
+        floor = floor,
+        page = topicPageOfFloor(floor),
+        repliesNum = 100,
+        at = at,
+    )
+
+    @Test
+    fun `floor maps to its page`() {
+        // 20 floors per page: floor 1 is page 1, floor 20 is page 1, floor 21 page 2.
+        assertEquals(1, topicPageOfFloor(1))
+        assertEquals(1, topicPageOfFloor(19))
+        assertEquals(1, topicPageOfFloor(20))
+        assertEquals(2, topicPageOfFloor(21))
+        assertEquals(2, topicPageOfFloor(40))
+        assertEquals(3, topicPageOfFloor(41))
+        assertEquals(26, topicPageOfFloor(512))
+        assertEquals(1, topicPageOfFloor(0))
+    }
+
+    @Test
+    fun `page maths is the inverse of the jump selector`() {
+        // The jump selector uses page = (floor + 20) / 20; ours must agree, so a
+        // recorded floor always lands on the page the selector would pick.
+        for (floor in 1..500) {
+            assertEquals((floor + 20) / 20, topicPageOfFloor(floor))
+        }
+    }
+
+    @Test
+    fun `only real topic ids are recorded`() {
+        assertEquals("42456351", topicReadingTid("42456351"))
+        assertNull(topicReadingTid(""))
+        assertNull(topicReadingTid("mnga_mock_topic"))
+    }
+
+    @Test
+    fun `put replaces an existing topic and keeps it most recent`() {
+        val first = topicReadingPositionsAfterPut(emptyMap(), position("a", 10))
+        val second = topicReadingPositionsAfterPut(first, position("a", 50))
+        assertEquals(1, second.size)
+        assertEquals(50, second.getValue("a").floor)
+    }
+
+    @Test
+    fun `put keeps distinct topics and evicts the oldest beyond capacity`() {
+        var positions = emptyMap<String, TopicReadingPosition>()
+        // capacity + 5 topics, "t1" inserted first and therefore oldest.
+        for (i in 1..(TopicReadingProgressStorage.capacity + 5)) {
+            positions = topicReadingPositionsAfterPut(positions, position("t$i", 1), capacity = 3)
+        }
+        // Untouched capacity (200) would keep everything; the explicit cap of 3
+        // proves eviction happens oldest-first.
+        assertEquals(3, positions.size)
+        assertNull(positions["t1"])
+        assertNull(positions["t2"])
+        assertNull(positions["t3"])
+        assertEquals(setOf("t4", "t5", "t6"), positions.keys)
+    }
+
+    @Test
+    fun `touching an old topic makes it recent again`() {
+        var positions = topicReadingPositionsAfterPut(emptyMap(), position("a", 1), capacity = 2)
+        positions = topicReadingPositionsAfterPut(positions, position("b", 1), capacity = 2)
+        // Re-record "a" — now "b" is the oldest and must be the one evicted.
+        positions = topicReadingPositionsAfterPut(positions, position("a", 9), capacity = 2)
+        positions = topicReadingPositionsAfterPut(positions, position("c", 1), capacity = 2)
+        assertEquals(setOf("a", "c"), positions.keys)
+        assertEquals(9, positions.getValue("a").floor)
+    }
+
+    @Test
+    fun `round trips through json`() {
+        jsonTest {
+            val positions = mapOf(
+                "111" to TopicReadingPosition("111", floor = 42, page = 3, repliesNum = 500, at = 1700),
+                "222" to TopicReadingPosition("222", floor = 7, page = 1, repliesNum = 8, at = 1800),
+            )
+            val restored = topicReadingPositionsFromJson(topicReadingPositionsToJson(positions))
+            assertEquals(positions, restored)
+        }
+    }
+
+    @Test
+    fun `json parsing is defensive`() {
+        jsonTest {
+            assertEquals(emptyMap<String, TopicReadingPosition>(), topicReadingPositionsFromJson(null))
+            assertEquals(emptyMap<String, TopicReadingPosition>(), topicReadingPositionsFromJson(""))
+            assertEquals(emptyMap<String, TopicReadingPosition>(), topicReadingPositionsFromJson("not json"))
+            assertEquals(emptyMap<String, TopicReadingPosition>(), topicReadingPositionsFromJson("[]"))
+            // Entries without a usable floor are dropped, the rest survive.
+            val mixed = topicReadingPositionsFromJson(
+                """{"good":{"floor":15,"replies":3},"bad":{"floor":0},"junk":7}"""
+            )
+            assertEquals(setOf("good"), mixed.keys)
+            assertEquals(15, mixed.getValue("good").floor)
+            // "page" is derived when the stored blob omits it.
+            assertEquals(topicPageOfFloor(15), mixed.getValue("good").page)
+        }
+    }
+
+    @Test
+    fun `json parsing trims an oversized blob`() {
+        jsonTest {
+            val big = LinkedHashMap<String, TopicReadingPosition>()
+            for (i in 1..10) big["t$i"] = position("t$i", i)
+            val restored = topicReadingPositionsFromJson(
+                topicReadingPositionsToJson(big),
+                capacity = 4,
+            )
+            assertEquals(4, restored.size)
+            // Oldest-first eviction leaves the four most recently written topics.
+            assertEquals(setOf("t7", "t8", "t9", "t10"), restored.keys)
+        }
+    }
+}
